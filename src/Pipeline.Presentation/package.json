{
  "name": "@pipeline/presentation",
  "version": "1.3.0",
  "private": true,
  "description": "Pipeline Presentation: React Native (Windows + iOS) + Expo Modules + NativeWind v4",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0 <25.0.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "postinstall": "node tools/patch-rnw.js",
    "start": "react-native start",
    "dev": "react-native start",
    "prewindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/setup-windows-toolchain.ps1 check",
    "windows": "powershell.exe -NoProfile -Command \"$env:MSBUILDDISABLENODEREUSE='1'; $env:CL='/MP2'; npx react-native run-windows --arch x64 --no-packager\"",
    "doctor:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/setup-windows-toolchain.ps1 check",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/setup-windows-toolchain.ps1 install",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ tools --max-warnings=0",
    "test": "jest --maxWorkers=2",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "check:structure": "ts-node tools/check-structure.ts",
    "check:contracts": "ts-node tools/check-contract-drift.ts",
    "check:i18n": "ts-node tools/check-i18n-keys.ts",
    "check:trace": "ts-node tools/check-traceability.ts",
    "check:docs": "ts-node tools/check-docs-links.ts",
    "docs:build": "ts-node tools/build-docs-reference.ts",
    "gen:feature": "ts-node tools/generate-feature/index.ts",
    "gen:command": "ts-node tools/generate-command/index.ts",
    "verify": "npm run check:structure && npm run check:contracts && npm run check:trace && npm run typecheck && npm run test",
    "test:windows": "jest --config jest.config.windows.js"
  },
  "dependencies": {
    "@react-native-windows/find-dotnet-tools": "0.0.0",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "expo": "~53.0.27",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-native": "0.83.2",
    "react-native-reanimated": "~3.19.5",
    "react-native-windows": "0.83.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "^0.83.2",
    "@react-native/babel-preset": "0.83.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "knip": "^5.88.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "@rnx-kit/jest-preset": "^0.3.1"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "@xmldom/xmldom": "^0.9.12",
    "uuid": "^11.1.1",
    "fast-xml-parser": "^5.11.2"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "PipelineApp",
      "namespace": "PipelineApp",
      "template": "cpp-app"
    }
  }
}
